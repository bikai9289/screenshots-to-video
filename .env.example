# Screenshots to Video — environment variables
#
# Local development:
#   cp .env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
#
# IMPORTANT: Admin Settings UI is disabled. All provider secrets and enable
# flags must be set here (local) or via `wrangler secret put` / wrangler vars
# (Cloudflare). Non-empty env values always win over database config rows.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Screenshots to Video
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Extra origins allowed to call the auth API (comma-separated).
AUTH_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# App (optional)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION=Turn product screenshots into demo and launch videos.
VITE_APP_LOGO=/logo.png
# Public support / notification mailbox. Empty keeps enquiries in admin tickets without email notifications.
VITE_SUPPORT_EMAIL=
VITE_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Stripe (payment) — server-only; never use VITE_ prefixes
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SIGNING_SECRET=
# Auto true when STRIPE_SECRET_KEY is set; override with true|false
STRIPE_ENABLED=
SELECT_PAYMENT_ENABLED=false
DEFAULT_PAYMENT_PROVIDER=stripe

# ---------------------------------------------------------------------------
# SeeAPI (screenshot → video generation)
# ---------------------------------------------------------------------------
SEEAPI_API_KEY=

# ---------------------------------------------------------------------------
# R2 / screenshots storage
# Private bucket for screenshot inputs (also bind SCREENSHOTS_BUCKET in wrangler)
SCREENSHOTS_STORAGE_BUCKET=screenshots-to-video-private
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=
# Optional custom S3-compatible HTTPS endpoint; blank = Cloudflare R2 default
R2_ENDPOINT=
# General/public media bucket used by modules/storage (r2_* keys)
R2_BUCKET_NAME=screenshots-to-video-public
R2_DOMAIN=
R2_UPLOAD_PATH=uploads
# Aliases also accepted: STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY, STORAGE_BUCKET,
# STORAGE_ENDPOINT, STORAGE_PUBLIC_DOMAIN

# ---------------------------------------------------------------------------
# Auth toggles (optional)
# ---------------------------------------------------------------------------
EMAIL_AUTH_ENABLED=true
EMAIL_VERIFICATION_ENABLED=
GOOGLE_AUTH_ENABLED=
GOOGLE_ONE_TAP_ENABLED=
GITHUB_AUTH_ENABLED=


# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------
# Enable with GOOGLE_AUTH_ENABLED=true (and optionally GOOGLE_ONE_TAP_ENABLED)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Analytics / ads / Search Console (optional)
# ---------------------------------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=
# Plausible site domain (legacy scripts) and optional script src URL
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=
# AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CODE=
# Google Search Console HTML meta verification token
GOOGLE_SITE_VERIFICATION=
# Optional Bing Webmaster Tools HTML meta verification token
BING_SITE_VERIFICATION=
# ---------------------------------------------------------------------------
# Email (optional — Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Database (advanced / non-sqlite)
# ---------------------------------------------------------------------------
# DATABASE_PROVIDER options: sqlite | postgres | mysql | turso | d1
# DATABASE_AUTH_TOKEN=                # Turso
# DB_SCHEMA=public
# DB_SINGLETON_ENABLED=false
# DB_MAX_CONNECTIONS=1
# AUTH_URL=http://localhost:3000

# Self-hosted Plausible script hosts (comma-separated). Optional.
PLAUSIBLE_SCRIPT_HOSTS=

# Optional source for scripts/sync-remote-to-local.ts (never commit real credentials)
SYNC_REMOTE_DATABASE_URL=
